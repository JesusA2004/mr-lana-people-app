{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://people.mr-lana.com/api/v1",
        "EXPO_PUBLIC_RH_WEB_URL": "https://people.mr-lana.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://people.mr-lana.com/api/v1",
        "EXPO_PUBLIC_RH_WEB_URL": "https://people.mr-lana.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
