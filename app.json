{
  "expo": {
    "name": "mr-lana-people-app",
    "slug": "mr-lana-people-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mrlanapeopleapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mrlana.people",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mrlana.people",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6FAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/logo-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6FAF8",
          "image": "./assets/images/brand/logo-mark.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/logo-mark.png",
          "color": "#4CB838"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MR. LANA PEOPLE necesita acceso a tus fotos para adjuntar documentos a tu expediente o solicitudes.",
          "cameraPermission": "MR. LANA PEOPLE necesita acceso a tu cámara para fotografiar documentos de tu expediente o solicitudes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f490fbd6-f59c-46c5-b24e-193d93b22dd0"
      }
    }
  }
}
