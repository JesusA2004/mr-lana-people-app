
# URL base de la API (Laravel) de MR. LANA PEOPLE, incluyendo /api/v1.
# En un dispositivo físico con Expo Go, "localhost" NO funciona: usa la IP
# de tu red local (ver README.md -> "localhost vs IP LAN").
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1

# Portal RH web: destino del CTA "Abrir Portal RH" para los procesos que
# solo existen en web (finiquitos, headcount, formatos, reportes...).
# Opcional — por defecto https://people.mr-lana.com
EXPO_PUBLIC_RH_WEB_URL=https://people.mr-lana.com
